generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id      Int      @id @default(autoincrement())
  email   String   @unique
  name    String?
  auth_id String?  @unique @db.Uuid
  Post    Post[]
  reviews Review[]
}

model Review {
  id        BigInt   @id @unique @default(autoincrement())
  title     String   @default("")
  content   String   @default("")
  schoolId  String   @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  Rating    Int?
  rating    Int?
  academics Int?
  social    Int?
  food      Int?
  housing   Int?
  career    Int?
  tags      String[]
  major     String?
  authorId  String?  @db.Uuid
  author    User?    @relation(fields: [authorId], references: [auth_id], onDelete: NoAction, onUpdate: NoAction)
  school    School   @relation(fields: [schoolId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model School {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  city            String?
  state           String?
  type            String?
  size            Int?
  school_url      String?
  external_source String?
  external_id     String?  @unique
  reviews         Review[]

  @@map("schools")
}

model Post {
  id        Int     @id @default(autoincrement())
  title     String
  content   String?
  published Boolean @default(false)
  authorId  Int?
  User      User?   @relation(fields: [authorId], references: [id])
}
